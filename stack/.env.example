# Version-pinned images verified against official release channels on 2026-08-23.
PROMETHEUS_IMAGE=prom/prometheus:v3.13.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.33.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.28.0
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.5
GRAFANA_IMAGE=grafana/grafana:13.1.0
GITLAB_RUNNER_IMAGE=gitlab/gitlab-runner:v19.3.0
CADDY_IMAGE=caddy:2.11.4-alpine

PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
TZ=Asia/Riyadh

# Public HTTPS endpoint. The Caddy service starts only with --profile public.
PUBLIC_FRONTEND_ENABLED=false
PUBLIC_DOMAIN=www.cloudsphere-sda.online
PUBLIC_APEX_DOMAIN=cloudsphere-sda.online

# Set by scripts/deploy-azure.sh for the self-managed GitLab instance.
GITLAB_URL=http://gitlab.example.internal
GITLAB_PRIVATE_URL=
